rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Accredited Lawyer profile documents
    match /lawyers/{lawyerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == lawyerId;
    }

    // Consultation requests between Citizen and Lawyer
    match /consultation_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Real-time Chat Rooms
    match /chat_rooms/{roomId} {
      allow read, write: if request.auth != null;
      
      // WhatsApp-style 1-on-1 Messages
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
