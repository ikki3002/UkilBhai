<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Material 3 DayNight Theme without ActionBar -->
    <style name="Theme.UkilBhai" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/mint_accent_alpha</item>
        <item name="colorOnPrimaryContainer">@color/mint_accent</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">@color/mint_accent</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
