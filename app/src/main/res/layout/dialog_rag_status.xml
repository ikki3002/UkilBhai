<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Legal Badge"
            android:src="@drawable/ic_badge"
            app:tint="@color/primary_emerald" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="বাংলাদেশ আইন ভাণ্ডার"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rag_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="100% On-Device"
            android:textColor="@color/primary_emerald"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="অন-ডিভাইস সংবিধিবদ্ধ আইন অনুসন্ধান (RAG ইঞ্জিন)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Info Metrics Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/bg_dark"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_active_dot" />

                <TextView
                    android:id="@+id/tvRagEngineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ইঞ্জিন স্থিতি: প্রস্তুত ও সম্পূর্ণ সক্রিয়"
                    android:textColor="@color/primary_emerald"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRagStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• ৩৭টি জাতীয় আইন | ৩,৫০৮টি ধারা ইনডেক্সড\n• SQLite FTS5 হাইপারস্পিড রিট্রিভার\n• অফলাইনেও তাৎক্ষণিক ধারা উদ্ধৃতি তৈরি করে"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Test Search Section Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="লাইভ সার্চ টেস্ট (আপনার ডিভাইসে সরাসরি যাচাই করুন):"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Search Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etTestRagQuery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:hint="যেমন: ময়লা, পাবলিক ন্যুসেন্স, চেক, যৌতুক..."
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp"
            android:inputType="text" />

        <Button
            android:id="@+id/btnTestRagSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary_emerald"
            android:text="খুঁজুন"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Results Display -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_search_pill"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTestRagResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="উপরে যেকোনো আইনি প্রশ্ন বা শব্দ লিখে 'খুঁজুন' বাটনে চাপ দিন।"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnCloseRagDialog"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/card_stroke"
        android:text="বন্ধ করুন"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
