<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".ChatActivity">

    <!-- Top App Bar Header -->
    <RelativeLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_card"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <!-- Title & Status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnBack"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="উকিল ভাই এআই"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_emergency_green"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="FREE AI"
                    android:textColor="@color/mint_accent"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="অনলাইন • তাৎক্ষণিক পরামর্শ"
                android:textColor="@color/mint_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Bot Avatar Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/bg_dark"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_emerald"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Bot Icon"
                android:src="@drawable/ic_chat" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <View
        android:id="@+id/dividerTopBar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar" />

    <!-- Offline / Airplane Mode Warning Banner -->
    <LinearLayout
        android:id="@+id/layoutOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emergency_red_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerTopBar">

        <ImageView
            android:id="@+id/ivOfflineBannerIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="Status Icon"
            android:src="@drawable/ic_traffic"
            app:tint="@color/emergency_red_text" />

        <TextView
            android:id="@+id/tvOfflineBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="ইন্টারনেট সংযোগ নেই। বার্তা পাঠানো যাবে না।"
            android:textColor="@color/emergency_red_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomInput"
        app:layout_constraintTop_toBottomOf="@id/layoutOfflineBanner" />

    <!-- Loading / Typing Indicator -->
    <LinearLayout
        android:id="@+id/layoutTypingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_chat_bubble_ai"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomInput"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/mint_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="উকিল ভাই উত্তর প্রস্তুত করছেন..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Input Container (Gemini Style Capsule Dock) -->
    <LinearLayout
        android:id="@+id/layoutBottomInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Unified Gemini Capsule Dock -->
        <LinearLayout
            android:id="@+id/layoutGeminiDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gemini_dock"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Plus / Add Shortcut Button -->
            <ImageButton
                android:id="@+id/btnAddAttachment"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add attachment or shortcut"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                app:tint="@color/gemini_icon_tint" />

            <!-- Text Input Area -->
            <EditText
                android:id="@+id/etUserPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="উকিল ভাই-কে জিজ্ঞাসা করুন..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="5"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Voice Input Button (Mic) -->
            <ImageButton
                android:id="@+id/btnVoiceInput"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="ভয়েস ইনপুট"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic"
                app:tint="@color/gemini_icon_tint" />

            <!-- Action Pill Button (Gemini Live Waveform <-> Send) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActionButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/gemini_live_pill_bg"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivActionIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Action Button"
                    android:src="@drawable/ic_waveform"
                    app:tint="@color/gemini_live_bars" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
